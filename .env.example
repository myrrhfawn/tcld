# Copy to .env and adjust. These are HOST paths mounted into the container
# as /data, /runs and /ckpt. Keep them outside git.
TCLD_DATA=./data
TCLD_RUNS=./runs
TCLD_CKPT=./checkpoints

# UID/GID used for the non-root user inside the image, so files written to the
# mounted volumes are owned by you. `make docker-build` fills these from `id`.
TCLD_UID=1000
TCLD_GID=1000

# Which GPUs the container sees (docker compose `gpus`). "all" or e.g. "0".
TCLD_GPUS=all
